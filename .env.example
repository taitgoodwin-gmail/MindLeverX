# The server reads process environment variables; it does not auto-load this file.
# Example: PORT=4318 MLX_SEED=false npm start
PORT=4317
MLX_DB_PATH=data/mindleverx.sqlite
MLX_SEED=true
# Optional Python executable with packages from requirements-pdf.txt installed.
# Defaults to python3; PDF failures do not prevent saved results from loading.
MLX_PDF_PYTHON=python3
